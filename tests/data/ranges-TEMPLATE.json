    { "id": "cast", "name": "Caster",         "vmetaLo": 1,   "vmetaHi": 8,    "min": null, "max": null, "appValue": null },
    { "id": "bal",  "name": "Brake balance",  "vmetaLo": 30,  "vmetaHi": 70,   "min": null, "max": null, "appValue": null },
    { "id": "pres", "name": "Brake pressure", "vmetaLo": 50,  "vmetaHi": 150,  "min": null, "max": null, "appValue": null },
    { "id": "dfa",  "name": "Diff front accel", "vmetaLo": 0, "vmetaHi": 100,  "min": null, "max": null, "appValue": null },
    { "id": "dra",  "name": "Diff rear accel",  "vmetaLo": 0, "vmetaHi": 100,  "min": null, "max": null, "appValue": null },
    { "id": "pF",   "name": "Tire psi F",     "vmetaLo": 10,  "vmetaHi": 55,   "min": null, "max": null, "appValue": null },
    { "id": "pR",   "name": "Tire psi R",     "vmetaLo": 10,  "vmetaHi": 55,   "min": null, "max": null, "appValue": null }
